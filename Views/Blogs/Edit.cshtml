@model Blog
@{
    ViewData["Title"] = "Редактирование блога";
}

<div class="wrap">
    <h1>Редактирование блога</h1>

    <form asp-controller="Blogs" asp-action="Edit" asp-route-id="@Model.BlogId" method="post">
        <div asp-validation-summary="ModelOnly" class="form-alert"></div>
        <input type="hidden" asp-for="BlogId" />
        <input type="hidden" asp-for="CreatedAt" />

    <div class="field">
        <label asp-for="Title"></label>
        <input asp-for="Title" class="form-control" />
        <span asp-validation-for="Title" class="error"></span>
    </div>

    <div class="field">
        <label asp-for="Description"></label>
        <textarea asp-for="Description" rows="4" class="form-control"></textarea>
        <span asp-validation-for="Description" class="error"></span>
    </div>

        <div class="field">
            <button type="submit" class="btn btn-blue">Сохранить изменения</button>
            <a asp-action="Index">Отмена</a>
        </div>
    </form>
</div>
